# Telegram bot token from @BotFather
BOT_TOKEN=

# Owner/admin identity. Can also be configured from the owner-only /admin panel.
OWNER_ID=

# Optional legacy access list. /admin remains owner-only.
ALLOWED_USERS=

# MongoDB connection URI. Can also be configured from the owner-only /admin panel.
MONGO_URI=

# Owner-only download logs channel/chat ID.
LOGS_CHANNEL_ID=

# Owner-only dump channel/chat ID. Downloaded files are stored here first, then copied to the user.
DUMP_CHANNEL_ID=

# DiskWala extraction API.
DISKWALA_API_URL=https://api.teraboxdl.site/api/v1/diskwala/extract
DISKWALA_API_KEY=
DISKWALA_API_AUTH=bearer

# DiskWala browser/legacy fallbacks.
DISKWALA_PROXY_URL=
DISKWALA_BROWSER_RESOLVER=1
CHROMIUM_PATH=/usr/bin/chromium
DISKWALA_RESOLVER_URL=https://diskwala-dl-six.vercel.app/api/scrap

# TeraBox — PRIMARY and only resolver in this build.
TERABOX_SAMRA_API=https://samratbdownload.krishnalucky193.workers.dev/

# Optional MTProto user session for large Telegram uploads (>50 MB).
# Keep all three values in Koyeb/Heroku secrets; NEVER commit real values.
# API_ID / API_HASH are accepted as backward-compatible aliases.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Backward-compatible names if these are already present in your deployment.
API_ID=
API_HASH=
USER_SESSION_STRING=

# Existing YouTube resolver configuration.
YTDL_API_BASE=https://api-dark-shan-yt.koyeb.app
YTDL_API_KEY=
YTDL_MP3_FORMAT=320

# 0 = no application download-size cap.
DOWNLOAD_MAX_MB=0

# Public Bot API is capped at 50 MB. Files above that use MTProto when configured.
MAX_FILE_MB=48

# MTProto upload tuning.
MT_PROTO_WORKERS=16

FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
FFMPEG_AUDIO_BITRATE=128k
FFMPEG_TIMEOUT_MS=7200000
REQUEST_TIMEOUT_MS=60000
DOWNLOAD_DIR=./downloads

# Optional local Telegram Bot API server for 2 GB uploads.
# TELEGRAM_API_ROOT=http://localhost:8081
# MAX_FILE_MB=2000
