# Telegram bot token from @BotFather
BOT_TOKEN=

# Optional: restrict bot to these Telegram user/chat IDs.
# If empty, the first /start claims ownership.
ALLOWED_USERS=

# DiskWala uses the existing public resolver. Override only if it moves.
DISKWALA_RESOLVER_URL=https://diskwala-dl-six.vercel.app/api/scrap

# Terabox session cookie(s), comma-separated when using more than one account.
TERABOX_COOKIES=

# Existing YouTube resolver configuration.
YTDL_API_BASE=https://api-dark-shan-yt.koyeb.app
YTDL_API_KEY=
YTDL_MP3_FORMAT=320

MAX_FILE_MB=48
REQUEST_TIMEOUT_MS=25000
DOWNLOAD_DIR=./downloads

# Optional local Telegram Bot API server for larger uploads.
# TELEGRAM_API_ROOT=http://localhost:8081
# MAX_FILE_MB=2000
